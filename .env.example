# Скопируйте этот файл в .env и заполните значения.
# Файл .env добавлен в .gitignore и НЕ попадает в git.

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# ID закрытого канала вида -1001234567890 (обязательно)
CHANNEL_ID=

# Название канала в текстах бота
CHANNEL_TITLE=закрытый канал

# Публичная ссылка канала (необязательно, только для текстов)
CHANNEL_PUBLIC_LINK=

# Telegram ID администраторов через запятую (обязательно для админ-команд)
ADMIN_IDS=

# Срок жизни персональной инвайт-ссылки, часы
INVITE_TTL_HOURS=24

# Льготный период после окончания подписки, часы (0 — кик сразу)
GRACE_HOURS=0

# Напоминания: за сколько дней до окончания
REMINDER_DAYS_1=3
REMINDER_DAYS_2=1

# Тариф «1 месяц»: срок и цена в Stars
PLAN_1M_DAYS=30
PLAN_1M_STARS=300

# Тариф «3 месяца»: срок и цена в Stars
PLAN_3M_DAYS=90
PLAN_3M_STARS=750

# Часовой пояс для дат
TIMEZONE=Europe/Moscow

LOG_LEVEL=INFO
